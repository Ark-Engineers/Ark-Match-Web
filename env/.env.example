# 通用必填配置
# VITE_APP_ENV: 环境标识（dev/prod）
VITE_APP_ENV=dev

# VITE_API_BASE_URL: API 接口基础地址
VITE_API_BASE_URL=http://localhost:3000

# VITE_PORT: 开发服务器端口（vite dev）
VITE_PORT=5173

# VITE_PREVIEW_PORT: 预览服务器端口（vite preview）
VITE_PREVIEW_PORT=4173

# VITE_ASSET_BASE: 静态资源基础路径（vite base）
VITE_ASSET_BASE=/

# VITE_STATIC_PUBLIC_PATH: 静态资源访问前缀（业务自定义使用）
VITE_STATIC_PUBLIC_PATH=/

# 开发环境专属
# VITE_DEBUG: 调试模式开关
VITE_DEBUG=true

# VITE_PROXY_PREFIX: 本地代理前缀
VITE_PROXY_PREFIX=/api

# VITE_PROXY_TARGET: 本地代理目标地址
VITE_PROXY_TARGET=http://localhost:3000

# VITE_LOG_LEVEL: 日志级别（debug/info/warn/error）
VITE_LOG_LEVEL=debug

# 生产环境专属
# VITE_DROP_CONSOLE: 生产构建是否移除 console/debugger
VITE_DROP_CONSOLE=true

# VITE_SOURCEMAP: 是否生成 sourcemap（true/false）
VITE_SOURCEMAP=false

# VITE_ENABLE_ANALYZE: 是否开启产物分析（预留）
VITE_ENABLE_ANALYZE=false

# VITE_PROD_DOMAIN: 生产环境域名（预留）
VITE_PROD_DOMAIN=example.com

